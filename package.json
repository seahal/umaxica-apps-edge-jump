{
  "name": "umaxica-apps-edge-jump",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "scripts": {
    "format": "vp fmt . --write",
    "format:check": "vp fmt . --check",
    "keys:generate": "node scripts/generate-jump-keypair.mjs",
    "cloudflare:check": "wrangler deploy --dry-run --env=\"\" --outdir dist/cloudflare",
    "cloudflare:dev": "wrangler dev --local --ip 127.0.0.1 --port 5209",
    "lint": "vp lint --type-aware --fix .",
    "lint:check": "vp lint --type-aware .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --config vitest.config.ts",
    "test:cov": "vitest run --config vitest.config.ts --coverage",
    "test:e2e": "playwright test",
    "test:worker": "node scripts/test-worker.mjs"
  },
  "dependencies": {
    "hono": "^4.13.19",
    "jose": "^6.2.18"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "catalog:",
    "@hono/node-server": "^2.1.11",
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "catalog:",
    "esbuild": "0.28.2",
    "knip": "^6.47.0",
    "miniflare": "5.20261119.0-beta",
    "typescript": "7.0.2",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:",
    "wrangler": "^4.166.0"
  },
  "engines": {
    "node": "26.13.1"
  },
  "packageManager": "pnpm@12.22.0+sha512.894940a3d9a57dfa6fd373990fb4e41e09c2f2d76d982ed1d75275d39267f988fb4e2d40900cbe9921c68d97c67aa1a1096d276633db248f7b34927ac9ddb7a4"
}
