{
  "name": "umaxica-apps-edge-jump",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "format": "oxfmt . --write",
    "format:check": "oxfmt . --check",
    "keys:generate": "node scripts/generate-jump-keypair.mjs",
    "cloudflare:check": "wrangler deploy --dry-run --outdir dist/cloudflare",
    "cloudflare:dev": "wrangler dev --local --ip 0.0.0.0 --port 5209",
    "lint": "oxlint --type-aware --fix .",
    "lint:check": "oxlint --type-aware .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:cov": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:worker": "node scripts/test-worker.mjs"
  },
  "dependencies": {
    "hono": "^4.13.13",
    "jose": "^6.2.12"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "catalog:",
    "@hono/node-server": "^2.1.3",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.4",
    "@vitest/coverage-v8": "5.0.3",
    "esbuild": "0.28.2",
    "knip": "^6.40.0",
    "miniflare": "5.20261006.0-alpha",
    "oxfmt": "0.72.0",
    "oxlint": "1.87.0",
    "oxlint-tsgolint": "7.0.2003",
    "tsx": "^4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.3",
    "vitest": "5.0.3",
    "wrangler": "^4.148.0"
  },
  "engines": {},
  "packageManager": "pnpm@12.0.0+sha512.9e2e3dc3911995868dc94b8175c217c27e95408fa03b4a22749778f2b34f773b77cdd3b39ede8171b22fcd53be6a35342e9fac9948a68ef58df6488ce89a7e67"
}
