# Loaded by direnv. Run `direnv allow` after reviewing changes to this file.
# Node.js and pnpm come from Vite+ (`vp env`), not from this file.
# Shell environment variables for this repository live here (adr/0011-use-direnv.md); there are no
# .env files. Shared, non-secret settings go in this file, real credentials in
# .envrc.credential and machine-specific overrides in .envrc.local; both are git-ignored.
# Override order, broadest first; a later file wins:
#   .envrc (shared, committed) -> .envrc.credential (credentials, git-ignored)
#   -> .envrc.local (this machine only, git-ignored)
source_env_if_exists .envrc.credential
source_env_if_exists .envrc.local
