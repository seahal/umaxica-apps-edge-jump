{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "umaxica-apps-edge-jump",
  "main": "src/cloudflare.ts",
  // Cloudflare runs the Worker first so asset responses share the security,
  // request-ID, no-cookie, and no-store contract. Fastly remains unchanged.
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "compatibility_date": "2026-05-26",
  "compatibility_flags": ["nodejs_compat"],
  "version_metadata": {
    "binding": "UMAXICA-APPS-EDGE-JUMP-VERSION"
  },
  "ratelimits": [
    {
      "name": "JUMP_RATE_LIMITER",
      "namespace_id": "1006",
      "simple": {
        "limit": 600,
        "period": 60
      }
    },
    {
      "name": "JWKS_RATE_LIMITER",
      "namespace_id": "1000",
      "simple": {
        "limit": 600,
        "period": 60
      }
    },
    {
      "name": "INFO_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 300,
        "period": 60
      }
    }
  ],
  "secrets_store_secrets": [
    {
      "binding": "UMAXICA_JUMP_PRIVATE_KEY_PEM",
      "store_id": "eb74dec1a757471281526676fb6e6509",
      "secret_name": "UMAXICA_JUMP_PRIVATE_KEY_PEM"
    }
  ],
  "vars": {
    "UMAXICA_JUMP_ORIGIN": "https://jump.umaxica.net",
    "UMAXICA_JUMP_PRIVATE_KEY_KID": "cloudflare-active-2026-05",
    "UMAXICA_JUMP_PUBLIC_JWKS": "{\"keys\":[{\"kty\":\"EC\",\"x\":\"aVliHGIbfzOCH-_OHcko1TQuiVyBfpfcUdisWC_EvsEYSC3F5AVqxN-R6GgK6fnY\",\"y\":\"mGwfPjzHLy_YedTy5EvmLD5VJC4TDhBQiVwoxlwRoPVEX_i86QB3e5RdgwwRBVux\",\"crv\":\"P-384\",\"kid\":\"cloudflare-active-2026-05\",\"alg\":\"ES384\",\"use\":\"sig\"}]}"
  },
  "workers_dev": false,
  "routes": [
    {
      "pattern": "jump.umaxica.net",
      "zone_name": "umaxica.net",
      "custom_domain": true
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      // Cloudflare's own invocation logs record the full request URL, which for
      // `GET /?rt=<jwt>` is the inbound token and the destination. The structured
      // application logs above are redacted (see redactLogLine in src/index.ts);
      // invocation logs are not, so they stay off.
      "invocation_logs": false
    },
    "traces": {
      "enabled": true,
      "persist": true,
      "head_sampling_rate": 1
    }
  }
}
