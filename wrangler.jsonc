{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "umaxica-apps-edge-jump",
  "main": "src/cloudflare.ts",
  // Cloudflare runs the Worker first so asset responses share the security,
  // request-ID, no-cookie, and no-store contract. Fastly remains unchanged.
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "compatibility_date": "2026-05-26",
  "compatibility_flags": ["nodejs_compat"],
  "version_metadata": {
    "binding": "UMAXICA-APPS-EDGE-JUMP-VERSION"
  },
  "ratelimits": [
    {
      "name": "JUMP_RATE_LIMITER",
      "namespace_id": "1006",
      "simple": {
        "limit": 600,
        "period": 60
      }
    }
  ],
  "vars": {
    "UMAXICA_JUMP_ORIGIN": "https://jump.umaxica.net",
    "UMAXICA_JUMP_PRIVATE_KEY_KID": "cloudflare-active-2026-09-12-871e7273",
    "UMAXICA_JUMP_PUBLIC_JWKS": "{\"keys\":[{\"kty\":\"EC\",\"x\":\"gCxcSIjgAUZeet-kGp1phZ1WbP2Y54pL-Hk5NUGvfEkIAAZhTsB4nk0qPbzBmZSg\",\"y\":\"EQDtyh4VoT-BL3p9y-xccaOj3C-oUIqN_Me33MPxAjSXYYvytDtQi7AV2vSDihup\",\"crv\":\"P-384\",\"kid\":\"cloudflare-active-2026-09-12-871e7273\",\"alg\":\"ES384\",\"use\":\"sig\"}]}"
  },
  "workers_dev": false,
  "routes": [
    {
      "pattern": "jump.umaxica.net",
      "zone_name": "umaxica.net",
      "custom_domain": true
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      // Invocation logs expose the full rt query token; application logs are redacted.
      "invocation_logs": false,
      "persist": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true
    }
  }
}
